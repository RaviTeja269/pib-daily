  "high_signal": [
    { "pattern": "cabinet approves|cabinet approved|cabinet decision|ccea|union cabinet|cabinet nod", "points": 4, "label": "Cabinet decision" },
    { "pattern": "year[- ]end review|year ender", "points": 3, "label": "Year-end review" },
    { "pattern": "backgrounder|explainer|factsheet|fact sheet", "points": 2, "label": "Explainer" },
    { "pattern": "\\bmou\\b|memorandum of understanding|agreement signed|signs? (an )?agreement|signed an agreement|\\bpact\\b|\\btreaty\\b", "points": 2, "label": "MoU / agreement" },
    { "pattern": "(launch|unveil|roll(s|ed)? out|introduc|flags? off|inaugurat)\\w*.{0,60}(scheme|portal|mission|app\\b|platform|initiative|programme|yojana|abhiyan|campaign|dashboard|index)", "points": 2.5, "label": "Scheme / portal launch" },
    { "pattern": "\\bnotif(y|ies|ied|ication)\\b|gazette|\\brules?, 20\\d\\d", "points": 2, "label": "Notification / rules" },
    { "pattern": "\\bbill\\b|\\bact, 20\\d\\d|\\bamendment\\b|\\bordinance\\b", "points": 2, "label": "Law / bill" },
    { "pattern": "\\breport\\b|\\bindex\\b|ranking|\\bsurvey\\b|\\brank(s|ed)?\\b|\\bdata (shows|released)|statistics|\\bestimates?\\b", "points": 2, "label": "Report / index" },
    { "pattern": "guidelines|\\bpolicy\\b|framework|\\bsop\\b|roadmap|\\bstrategy\\b|standard operating", "points": 2, "label": "Policy / guidelines" },
    { "pattern": "(joint|naval|military|air|tri-service|bilateral|multilateral)\\s+exercise|\\bexercise\\s+['‘“\"A-Z]", "points": 3, "label": "Exercise" },
    { "pattern": "declared|designated|inscribed|recogni[sz]ed|\\bunesco\\b|\\bramsar\\b|gi tag|geographical indication", "points": 2.5, "label": "Recognition / tag" },
    { "pattern": "joint statement|strategic partnership|bilateral (visit|talks|meeting)|state visit", "points": 2, "label": "Bilateral outcome" },
    { "pattern": "\\bisro\\b|lift ?off|launch (vehicle|of).{0,40}(satellite|mission)|satellite.{0,40}launch|\\bgaganyaan\\b|\\bchandrayaan\\b", "points": 2.5, "label": "Space mission" },
    { "pattern": "first[- ]ever|first time|world'?s (largest|first)|india'?s first|indigenous|record", "points": 1.5, "label": "First / record" },
    { "pattern": "committee|commission|task force|constitutes|constituted|\\bpanel\\b", "points": 1.5, "label": "Committee / body" },
    { "pattern": "salient features|key features|key highlights", "points": 1.5, "label": "Salient features" },
    { "pattern": "approved|sanction(ed|s)?|outlay|\\bcrore\\b", "points": 1, "label": "Funding" },
    { "pattern": "appointed|appointment of|assumes charge|takes charge", "points": 1, "label": "Appointment" },
    { "pattern": "(celebrat|observ|mark)\\w*.{0,40}(day|week|diwas|saptah)|\\bworld \\w+ day\\b|international day", "points": 1, "label": "Day / observance" }
  ],

  "low_signal": [
    { "pattern": "calls? on |called on|courtesy call|greets|greetings|wishes|condol|pays? (rich )?tribute|paid homage|pays homage|credentials", "points": 3, "label": "Courtesy / ceremonial" },
    { "pattern": "special campaign|swachhata pakhwada|pending matters|disposal of pending|institutionali[sz]ing swachhata", "points": 2.5, "label": "Routine admin campaign" },
    { "pattern": "tender|answer key|limited departmental competitive|recruitment result|results? of|examination, 20\\d\\d|admit card|vacancy circular", "points": 3, "label": "Admin notice" },
    { "pattern": "birthday|punyatithi|birth anniversary", "points": 1, "label": "Birthday / anniversary" },
    { "pattern": "\\b(reviews?|chairs?|visits?|inspects?|takes? stock|attends?|addresses|interacts?|participates?|meets|interacted)\\b", "points": 1, "label": "Routine event" },
    { "pattern": "photo gallery|media advisory|media invitation|invitation to", "points": 2, "label": "Media notice" }
  ],

